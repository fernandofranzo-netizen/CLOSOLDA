rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Clients collection
    match /clients/{clientId} {
      allow get, create, update, delete: if isValidId(clientId);
      allow list: if true;
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow get, create, update, delete: if isValidId(appointmentId);
      allow list: if true;
    }

    // Quotes collection
    match /quotes/{quoteId} {
      allow get, create, update, delete: if isValidId(quoteId);
      allow list: if true;
    }

    // Quote items collection
    match /quote_items/{itemId} {
      allow get, create, update, delete: if isValidId(itemId);
      allow list: if true;
    }

    // Projects collection
    match /projects/{projectId} {
      allow get, create, update, delete: if isValidId(projectId);
      allow list: if true;
    }

    // Project photos collection
    match /project_photos/{photoId} {
      allow get, create, update, delete: if isValidId(photoId);
      allow list: if true;
    }

    // Reports collection
    match /reports/{reportId} {
      allow get, create, update, delete: if isValidId(reportId);
      allow list: if true;
    }

    // Documents collection
    match /documents/{documentId} {
      allow get, create, update, delete: if isValidId(documentId);
      allow list: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow get, create, update, delete: if isValidId(settingId);
      allow list: if true;
    }

    // Test collection for boot diagnostics
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
